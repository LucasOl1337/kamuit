<Window x:Class="KamuiT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:term="clr-namespace:EasyWindowsTerminalControl;assembly=EasyWindowsTerminalControl"
        Title="KamuiT" Background="#FF0C0C0C"
        Icon="kamuit.ico"
        WindowState="Maximized"
        Closing="OnClosing"
        KeyboardNavigation.TabNavigation="None"
        KeyboardNavigation.ControlTabNavigation="None"
        KeyboardNavigation.DirectionalNavigation="None">
    <Window.Resources>
        <!-- Scrollbar escura fina estilo Windows Terminal (a default do wrapper e branca/bugada) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="#FF1E1E1E">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="false"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="#FF5A5A5A"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="false"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botao de fechar aba / nova aba: minimalista escuro -->
        <Style x:Key="TabIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF999999"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF3A3A3A" TargetName="Bd"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de abas -->
        <Border Grid.Row="0" Background="#FF181818" BorderBrush="#FF2D2D2D" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <ItemsControl x:Name="TabList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Background explícito pra hit-test no padding; título não rouba o mouse do drag -->
                            <Border x:Name="TabBorder" Padding="14,7" Background="#00000000"
                                    BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                    Cursor="SizeAll" Tag="{Binding}"
                                    PreviewMouseLeftButtonDown="OnTabHeaderPreviewMouseDown"
                                    PreviewMouseMove="OnTabHeaderPreviewMouseMove"
                                    PreviewMouseLeftButtonUp="OnTabHeaderPreviewMouseUp"
                                    LostMouseCapture="OnTabHeaderLostCapture">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" Foreground="#FFCCCCCC" VerticalAlignment="Center"
                                               MaxWidth="220" TextTrimming="CharacterEllipsis"
                                               IsHitTestVisible="False"/>
                                    <Button Content="&#x2715;" Tag="{Binding}" Click="OnTabCloseClick"
                                            Style="{StaticResource TabIconButton}" Margin="10,0,0,0" FontSize="10"/>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="Background" Value="#FF252526" TargetName="TabBorder"/>
                                    <Setter Property="BorderBrush" Value="#FF0078D4" TargetName="TabBorder"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="+" Click="OnNewTabClick" Style="{StaticResource TabIconButton}"
                        FontSize="14" FontWeight="Bold" VerticalAlignment="Center" ToolTip="Nova aba (Ctrl+Shift+T)"/>
            </StackPanel>
        </Border>

        <!-- Terminais: TODAS as abas ficam na árvore visual o tempo todo,
             alternando só Visibility (Collapsed esconde o HWND sem destruí-lo).
             Reparenting de HwndHost destrói/recria o HWND nativo e crasha. -->
        <Grid x:Name="TermArea" Grid.Row="1"/>
    </Grid>
</Window>
